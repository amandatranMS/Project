FOUNDRY_PROJECT_ENDPOINT="..."
AZURE_AI_MODEL_DEPLOYMENT_NAME="..."

# ---- MSX API connection ----
API_BASE_URL="http://localhost:4000"
# Static fallback key (used only when MSX_API_SCOPE below is blank).
API_KEY=""

# ---- Entra token auth (preferred; lets Conditional Access govern the agent) ----
# Scope of the MSX API app registration. When set, the agent sends an Entra
# bearer token instead of API_KEY. Example: api://<msx-api-client-id>/.default
MSX_API_SCOPE=""
# Set BOTH to federate the hosted managed identity into the agent's Entra Agent
# ID app (token that reaches the API = the agent app; cleanest CA scoping).
# Leave AGENT_APP_CLIENT_ID blank to call as the managed identity directly.
AAD_TENANT_ID=""
AGENT_APP_CLIENT_ID=""