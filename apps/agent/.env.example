# Model provider (GitHub Models by default — OpenAI-compatible).
# Get a token at https://github.com/settings/tokens with the "models" permission,
# or a fine-grained token with Models: read. Paste it below.
GITHUB_TOKEN=""
MODEL_ENDPOINT="https://models.github.ai/inference"
MODEL_NAME="openai/gpt-4o-mini"

# To switch to Azure AI Foundry later, set these instead of GITHUB_TOKEN and point
# MODEL_ENDPOINT at your Foundry/Azure OpenAI endpoint + deployment name.
# MODEL_API_KEY=""

# Your MSX Milestone Assistant API (the mock app).
API_BASE_URL="http://localhost:4000"
API_KEY="msx-demo-9f3k2p7q"
