# Cloud database: Azure Database for PostgreSQL Flexible Server.
# TLS is required (sslmode=require). URL-encode special chars in the password
# (e.g. @ -> %40). The real value lives in .env (gitignored) — never commit it.
DATABASE_URL="postgresql://<admin-user>:<url-encoded-password>@<your-server>.postgres.database.azure.com:5432/<database>?sslmode=require"

# API server
PORT=4000

# Frontend origin allowed by CORS
WEB_ORIGIN="http://localhost:5173"

# Optional API key. Leave BLANK for normal local dev (no auth enforced).
# Set a value before exposing the API over a public tunnel (e.g. to a Copilot
# Studio agent): every /api request must then send a matching `x-api-key` header.
# The Vite dev proxy forwards this same value so the web app keeps working.
API_KEY=""

# ---- Microsoft Entra ID auth for /api (real identity; Option B) ----
# Set BOTH to validate Entra bearer tokens (signed-in users AND the agent's
# app-only token). Same app registration used by the web app's MSAL login.
#   AAD_TENANT_ID — directory (tenant) id
#   AAD_CLIENT_ID — application (client) id; token audience is this or api://<it>
AAD_TENANT_ID=""
AAD_CLIENT_ID=""
# Client secret on the SAME app registration. Powers the On-Behalf-Of (OBO) flows:
#   • Microsoft Graph sends as the signed-in user (Teams / Outlook), and
#   • the Foundry model call as the signed-in user, which is what makes Microsoft
#     Purview DLP *enforce* (app-only / managed-identity tokens are audited only).
# Also needs an admin-consented delegated Azure AI permission on this app
# registration + a per-user "Azure AI User" role on the Foundry account. See
# docs/security.md (Part 2 → "Enforce DLP on the Foundry hosted agent").
AAD_CLIENT_SECRET=""
# Optional CSV allowlist of application ids allowed to call as a service via an
# Entra token (e.g. the agent app / its managed identity). Blank = accept any
# app token that already passed issuer + audience checks.
AGENT_ALLOWED_APP_IDS=""

# ---- Chat assistant (in-app engine) ----
# Azure OpenAI (Foundry) model deployment used by the built-in chat box.
# The account may have local keys disabled, in which case auth uses your
# `az login` identity (DefaultAzureCredential) — no key needed here.
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT="gpt-5-mini"
AZURE_OPENAI_API_VERSION="2024-10-21"

# Re-enable the in-app (direct Azure OpenAI) engine. OFF by default — every chat
# turn goes to the Foundry hosted agent. Set to "true" to allow engine:"in-app"
# turns again. Microsoft Purview DLP governs BOTH engines as long as the model call
# runs as the signed-in user — the hosted agent does this via OBO (AAD_CLIENT_SECRET
# above); see docs/security.md.
IN_APP_ENGINE_ENABLED="false"

# Application name reported to Microsoft Defender for Cloud / Purview in the
# per-call user-security context (used to attribute AI alerts to this app).
DEFENDER_AI_APP_NAME="Multi-Agent Sales Assistant"

# ---- Chat assistant (Foundry hosted agent — optional demo toggle) ----
# The Responses endpoint printed by `azd deploy`. Leave blank to disable the
# "Foundry hosted agent" option in the chat box.
FOUNDRY_AGENT_ENDPOINT=""

# ---- Defender content-safety screening (surfaces agent-UI jailbreaks in Defender) ----
# The hosted agent's streaming Responses path swallows content-filter blocks, so a
# jailbreak is refused but Microsoft Defender never sees the HTTP 400 it needs to raise
# an alert. When set, the API mirrors each user turn to this synchronous chat/completions
# endpoint on the SAME model deployment; a jailbreak trips the input Prompt Shield (400)
# → Defender alert + email. Fire-and-forget — never adds latency to or breaks the turn.
# Blank = disabled. Format:
#   https://<account>.cognitiveservices.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2025-01-01-preview
DEFENDER_SCREEN_ENDPOINT=""
DEFENDER_SCREEN_ENABLED="true"

# ---- Microsoft Graph sends (Teams / Outlook) ----
# 'simulate' records + audits sends WITHOUT delivering (no admin
# consent needed). 'live' actually delivers via Microsoft Graph as the signed-in
# user and requires admin-consented delegated scopes (Chat.ReadWrite +
# ChatMessage.Send for Teams, Mail.Send for Outlook).
GRAPH_SEND_MODE="simulate"

# ---- Notify the team when a new opportunity is created ----
# Master switch for the auto broadcast (set to "false" to disable). Default ON.
NOTIFY_ON_OPPORTUNITY_CREATE="true"
# Approved opportunity broadcasts enumerate enabled tenant member accounts via
# User.Read.All, then send each member (except the sender) a 1:1 Teams message.
# User.Read.All requires administrator consent.

# ---- Session handles for agent tool callbacks (On-Behalf-Of) ----
# Signs the opaque session handle the API hands to the Foundry hosted agent so its
# tool callbacks can act as the signed-in user. Falls back to AAD_CLIENT_SECRET when
# unset. IMPORTANT: if you rotate AAD_CLIENT_SECRET without setting this explicitly,
# every in-flight session handle is invalidated. Set it to a dedicated random value
# to decouple session signing from client-secret rotation.
MSX_SESSION_SECRET=""

# ---- Foundry hosted agent call tuning (optional; defaults shown) ----
# Per-request timeout in ms for the hosted agent call.
FOUNDRY_TIMEOUT_MS="180000"
# Retry attempts for a failed hosted agent call (minimum 1).
FOUNDRY_MAX_ATTEMPTS="4"

# ---- Defender screening tuning (optional; defaults shown) ----
# Timeout in ms for the fire-and-forget Defender screening call.
DEFENDER_SCREEN_TIMEOUT_MS="15000"
# Max characters of the user turn mirrored to the screening endpoint.
DEFENDER_SCREEN_MAX_CHARS="8000"
# Set "true" to log screening activity to the API console (debugging only).
DEFENDER_SCREEN_DEBUG="false"

# ---- Simulated-send auto confirm (demo convenience) ----
# When "true" AND GRAPH_SEND_MODE="simulate", Graph sends skip the explicit
# confirm flag. Has NO effect when GRAPH_SEND_MODE="live" — the approval gate
# and confirmation still apply to every real send.
SEND_AUTO_CONFIRM="false"
