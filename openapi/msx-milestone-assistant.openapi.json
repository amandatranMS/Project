    "/api/approval-requests": {
      "get": {
        "tags": [
          "Approval Requests"
        ],
        "summary": "List approval requests",
        "description": "Each row includes a sanitized `pendingAction` decoded from the stored deferred action. CreateMilestone actions expose their mock business fields as `milestoneFields` and CreateOpportunity actions expose theirs as `opportunityFields` for human review, and UpdateMilestone exposes `milestoneStatus` for the \"Lost To Competitor\" warning. Sensitive message bodies and all other raw deferred action payloads are not exposed.\n",
        "parameters": [
          {
            "in": "query",
            "name": "approvalStatus",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Approval requests"
          }
        }
      },
      "post": {
        "tags": [
          "Approval Requests"
        ],
        "summary": "Create an approval request. May carry a deferred `action` (CreateMilestone, CreateOpportunity, SendOutlookMail, NotifyTeams, UpdateMilestone, UpdateOpportunity, UpdateDealTeamMember, or DeleteMilestone) that the API executes ONLY when a human approves the request. This is how agent writes/sends are gated.\n",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "requestName"
                ],
                "properties": {
                  "requestName": {
                    "type": "string"
                  },
                  "opportunityName": {
                    "type": "string",
                    "nullable": true
                  },
                  "relatedRecommendationBusinessId": {
                    "type": "string",
                    "nullable": true
                  },
                  "requestedBy": {
                    "type": "string",
                    "nullable": true
                  },
                  "action": {
                    "type": "object",
                    "description": "Optional deferred action executed on approval. The carried fields depend on `kind`: send actions use to/subject/body/message; CreateMilestone uses a complete MilestoneInput payload plus competitorBlankConfirmed; CreateOpportunity uses an OpportunityInput payload (opportunityName required); UpdateMilestone uses milestoneId + any MilestoneInput fields; UpdateOpportunity uses opportunityId + any OpportunityInput fields; UpdateDealTeamMember uses dealTeamMemberId + any DealTeamMemberInput fields; DeleteMilestone uses milestoneId.\n",
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "CreateMilestone",
                          "CreateOpportunity",
                          "SendOutlookMail",
                          "NotifyTeams",
                          "UpdateMilestone",
                          "UpdateOpportunity",
                          "UpdateDealTeamMember",
                          "DeleteMilestone"
                        ]
                      },
                      "competitorBlankConfirmed": {
                        "type": "boolean",
                        "description": "For CreateMilestone, must be true when competitorName is empty, confirming the user explicitly chose to leave Competitor blank. Ignored when milestoneStatus is \"Lost To Competitor\": that status always requires a non-empty competitorName and the request is rejected with 422 otherwise (for both CreateMilestone and UpdateMilestone, the latter checked against the target milestone's existing competitor at submit and execution time).\n"
                      },
                      "to": {
                        "type": "string"
                      },
                      "subject": {
                        "type": "string"
                      },
                      "body": {
                        "type": "string"
                      },
                      "message": {
                        "type": "string"
                      },
                      "milestoneId": {
                        "type": "string"
                      },
                      "opportunityId": {
                        "type": "string"
                      },
                      "dealTeamMemberId": {
                        "type": "string"
                      },
                      "milestoneName": {
                        "type": "string"
                      },
                      "milestoneStatus": {
                        "type": "string"
                      },
                      "milestoneCategory": {
                        "type": "string"
                      },
                      "owner": {
                        "type": "string"
                      },
                      "workload": {
                        "type": "string"
                      },
                      "customerCommitment": {
                        "type": "string"
                      },
                      "deliveredBy": {
                        "type": "string"
                      },
                      "partnerName": {
                        "type": "string"
                      },
                      "competitorName": {
                        "type": "string"
                      },
                      "statusReason": {
                        "type": "string"
                      },
                      "estDate": {
                        "type": "string",
                        "format": "date"
                      },
                      "fitCharge": {
                        "type": "number"
                      },
                      "nonRecurring": {
                        "type": "boolean"
                      },
                      "riskDescription": {
                        "type": "string"
                      },
                      "riskImpact": {
                        "type": "string"
                      },
                      "mitigationPlan": {
                        "type": "string"
                      },
                      "blockedReason": {
                        "type": "string"
                      },
                      "blockedOwner": {
                        "type": "string"
                      },
                      "blockedSince": {
                        "type": "string",
                        "format": "date"
                      },
                      "expectedResolutionDate": {
                        "type": "string",
                        "format": "date"
                      },
                      "escalated": {
                        "type": "boolean"
                      },
                      "azureCapacityType": {
                        "type": "string"
                      },
                      "preferredAzureRegion": {
                        "type": "string"
                      },
                      "comments": {
                        "type": "string"
                      },
                      "lastUpdated": {
                        "type": "string",
                        "format": "date"
                      },
                      "opportunityName": {
                        "type": "string"
                      },
                      "tpid": {
                        "type": "string"
                      },
                      "customerName": {
                        "type": "string"
                      },
                      "industry": {
                        "type": "string"
                      },
                      "solutionArea": {
                        "type": "string"
                      },
                      "salesStage": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string"
                      },
                      "estimatedRevenue": {
                        "type": "number"
                      },
                      "closeDate": {
                        "type": "string",
                        "format": "date"
                      },
                      "aeOwner": {
                        "type": "string"
                      },
                      "assignedSE": {
                        "type": "string"
                      },
                      "consumptionPhase": {
                        "type": "string"
                      },
                      "businessProblem": {
                        "type": "string"
                      },
                      "nextStep": {
                        "type": "string"
                      },
                      "personName": {
                        "type": "string"
                      },
                      "role": {
                        "type": "string"
                      },
                      "teamArea": {
                        "type": "string"
                      },
                      "addedDate": {
                        "type": "string",
                        "format": "date"
                      },
                      "active": {
                        "type": "boolean"
                      },
                      "handoffRequired": {
                        "type": "boolean"
                      },
                      "handoffNotes": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
