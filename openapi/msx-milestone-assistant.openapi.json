    "/api/milestones/{id}": {
      "get": {
        "tags": [
          "Milestones"
        ],
        "summary": "Get a milestone (with history, recommendations, approvals, notes)",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Milestone"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "patch": {
        "tags": [
          "Milestones"
        ],
        "summary": "Update a milestone",
        "description": "Updating milestoneStatus to \"Lost To Competitor\" triggers an executive-summary email to the seller's manager when `acknowledgeManagerEmail` is true (best-effort; never blocks the update). It also REQUIRES a competitor: pass `competitorName` or the milestone must already have one, otherwise the request is rejected with 422.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdParam"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MilestoneInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "422": {
            "description": "A competitor is required to move the milestone to \"Lost To Competitor\""
          }
        }
      },
      "delete": {
        "tags": [
          "Milestones"
        ],
        "summary": "Delete a milestone (status history is also removed)",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
