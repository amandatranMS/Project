    "/api/approval-requests/{id}/approve": {
      "patch": {
        "tags": [
          "Approval Requests"
        ],
        "summary": "Approve. If the request carries a deferred action, it is executed now (send email / notify Teams / create an opportunity / update a milestone, opportunity, or deal team member / delete milestone) and audited. Otherwise it performs the mock milestone writeback from the related recommendation (audited as CreateMilestone). If the action moves a milestone to \"Lost To Competitor\", an executive-summary email is sent to the reviewer's manager when `acknowledgeManagerEmail` is true.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdParam"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Approved (returns approval + created milestone or executed action)"
          },
          "409": {
            "description": "Already approved"
          },
          "422": {
            "description": "A competitor is required to move the milestone to \"Lost To Competitor\""
          }
        }
      }
    },
    "/api/approval-requests/{id}/reject": {
      "patch": {
        "tags": [
          "Approval Requests"
        ],
        "summary": "Reject an approval request (no milestone created; audited)",
        "parameters": [
