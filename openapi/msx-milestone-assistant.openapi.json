    "/api/status-history": {
      "get": {
        "tags": [
          "Status History"
        ],
        "summary": "List milestone status history",
        "parameters": [
          {
            "in": "query",
            "name": "milestoneId",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "History rows"
          }
        }
      },
      "post": {
        "tags": [
          "Status History"
        ],
        "summary": "Add a status change (moves the milestone to the new status)",
        "description": "Changing newStatus to \"Lost To Competitor\" triggers an executive-summary email to the seller's manager when `acknowledgeManagerEmail` is true (resolved from Microsoft Entra, audited; best-effort, never blocks the status change). It also REQUIRES a competitor: pass `competitorName` (or the milestone must already have one), otherwise the request is rejected with 422.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "milestoneBusinessId",
                  "newStatus",
                  "changedBy"
                ],
                "properties": {
                  "milestoneBusinessId": {
                    "type": "string",
                    "example": "MS-001"
                  },
                  "newStatus": {
                    "type": "string",
                    "example": "At Risk"
                  },
                  "oldStatus": {
                    "type": "string"
                  },
                  "changedBy": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "competitorName": {
                    "type": "string",
                    "description": "Required when newStatus is \"Lost To Competitor\" and the milestone has no competitor yet. Saved onto the milestone along with the status change.\n"
                  },
                  "acknowledgeManagerEmail": {
                    "type": "boolean",
                    "description": "Human acknowledgement authorising the manager email when newStatus is \"Lost To Competitor\".\n"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "422": {
            "description": "A competitor is required to move the milestone to \"Lost To Competitor\""
          }
        }
      }
    },
