  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Optional API key. Only enforced when the server has API_KEY set (e.g. when exposed over a public tunnel). Send it in the `x-api-key` request header.\n"
      }
    },
    "parameters": {
      "IdParam": {
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {},
          "error": {
            "type": "string"
          }
        }
      },
      "DecisionInput": {
        "type": "object",
        "required": [
          "reviewedBy"
        ],
        "properties": {
          "reviewedBy": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "agentName": {
            "type": "string"
          },
          "acknowledgeManagerEmail": {
            "type": "boolean",
            "description": "Human acknowledgement (from the Approvals-tab pop-up) authorising the executive-summary email to the reviewer's manager when approving an action that moves a milestone to \"Lost To Competitor\". Ignored for any other action.\n"
          }
        }
      },
      "OpportunityInput": {
        "type": "object",
        "required": [
          "opportunityName"
        ],
        "properties": {
          "opportunityBusinessId": {
            "type": "string",
            "description": "Auto-generated if omitted"
          },
          "opportunityName": {
            "type": "string"
          },
          "tpid": {
            "type": "string"
          },
          "customerName": {
            "type": "string"
          },
          "industry": {
            "type": "string"
          },
          "solutionArea": {
            "type": "string"
          },
          "salesStage": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "estimatedRevenue": {
            "type": "number"
          },
          "closeDate": {
            "type": "string",
            "format": "date"
          },
          "aeOwner": {
            "type": "string"
          },
          "assignedSE": {
            "type": "string"
          },
          "competitorName": {
            "type": "string"
          },
          "consumptionPhase": {
            "type": "string"
          },
          "businessProblem": {
            "type": "string"
          },
          "nextStep": {
            "type": "string"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "MilestoneInput": {
        "type": "object",
        "required": [
          "milestoneName",
          "opportunityName"
        ],
        "properties": {
          "milestoneBusinessId": {
            "type": "string",
            "description": "Auto-generated if omitted"
          },
          "milestoneName": {
            "type": "string"
          },
          "opportunityName": {
            "type": "string",
            "description": "Connects to Opportunity.opportunityName"
          },
          "workload": {
            "type": "string",
            "enum": [
              "M365 Copilot for Microsoft 365",
              "Microsoft Sentinel",
              "Microsoft Purview",
              "Azure Migration",
              "Copilot Studio",
              "Defender XDR",
              "Teams Premium"
            ]
          },
          "customerCommitment": {
            "type": "string",
            "enum": [
              "Uncommitted",
              "Verbal",
              "Committed",
              "Contracted"
            ]
          },
          "deliveredBy": {
            "type": "string",
            "enum": [
              "Microsoft",
              "Partner",
              "Customer",
              "Joint"
            ]
          },
          "partnerName": {
            "type": "string"
          },
          "competitorName": {
            "type": "string"
          },
          "milestoneCategory": {
            "type": "string",
            "enum": [
              "Production",
              "Pilot",
              "Workshop",
              "Assessment",
              "Deployment",
              "Adoption"
            ]
          },
          "milestoneStatus": {
            "type": "string",
            "enum": [
              "---",
              "On Track",
              "At Risk",
              "Blocked",
              "Completed",
              "Cancelled",
              "Lost To Competitor",
              "Hygiene/Duplicate"
            ]
          },
          "statusReason": {
            "type": "string"
          },
          "estDate": {
            "type": "string",
            "format": "date"
          },
          "fitCharge": {
            "type": "number"
          },
          "nonRecurring": {
            "type": "boolean"
          },
          "riskImpact": {
            "type": "string",
            "enum": [
              "High",
              "Medium",
              "Low"
            ]
          },
          "azureCapacityType": {
            "type": "string",
            "enum": [
              "---",
              "Azure Commit",
              "MACC",
              "Open",
              "CSP",
              "EA"
            ]
          },
          "preferredAzureRegion": {
            "type": "string",
            "enum": [
              "Canada Central",
              "Canada East",
              "East US",
              "West US",
              "West Europe",
              "North Europe"
            ]
          },
          "owner": {
            "type": "string"
          },
          "createdBy": {
            "type": "string"
          },
          "riskDescription": {
            "type": "string"
          },
          "mitigationPlan": {
            "type": "string"
          },
          "blockedReason": {
            "type": "string"
          },
          "blockedOwner": {
            "type": "string"
          },
          "blockedSince": {
            "type": "string",
            "format": "date"
          },
          "expectedResolutionDate": {
            "type": "string",
            "format": "date"
          },
          "escalated": {
            "type": "boolean"
          },
          "comments": {
            "type": "string"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date"
          },
          "acknowledgeManagerEmail": {
            "type": "boolean",
            "description": "Only honored on PATCH /api/milestones/{id}. When the update transitions the milestone INTO \"Lost To Competitor\", this human acknowledgement authorises an executive-summary email to the seller's manager (resolved from Microsoft Entra, audited). Ignored on create.\n"
          }
        }
      },
      "DealTeamMemberInput": {
        "type": "object",
        "required": [
          "opportunityName",
          "personName",
          "role"
        ],
        "properties": {
          "dealTeamMemberBusinessId": {
            "type": "string",
            "description": "Auto-generated if omitted"
          },
          "opportunityName": {
            "type": "string",
            "description": "Connects to Opportunity.opportunityName (create only)"
          },
          "personName": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "teamArea": {
            "type": "string"
          },
          "addedDate": {
            "type": "string",
            "format": "date"
          },
          "active": {
            "type": "boolean"
          },
          "handoffRequired": {
            "type": "boolean"
          },
          "handoffNotes": {
            "type": "string"
          }
        }
      }
    }
  }
}
