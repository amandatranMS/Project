    "/api/opportunities/{id}/announce": {
      "post": {
        "tags": [
          "Opportunities"
        ],
        "summary": "Send the \"new opportunity\" visibility message to the configured teammate over Microsoft Teams (Path A, human consent). Called from the create-confirm popup after a human agrees. Honors GRAPH_SEND_MODE (simulate vs live) and requires TEAMS_BROADCAST_TO to be set; audited via recordAgentAction.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdParam"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "confirm": {
                    "type": "boolean",
                    "description": "Human consent to deliver (default true)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Envelope with delivery result (sent/simulated/skipped)"
          },
          "400": {
            "description": "No Teams recipient configured"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
