# ---- Foundry project that RUNS the red-team scan (generates attacks + grades) ----
# Must be in a red-team supported region: East US 2, France Central, Sweden Central,
# Switzerland West, US North Central. The runner also falls back to FOUNDRY_PROJECT_ENDPOINT.
# Example: https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT=""

# ---- Target: the MSX app chat surface the attacks are fired at ----
# The runner posts to ${MSX_API_BASE_URL}/api/chat — the same path whose screenForDefender()
# shim raises Defender alerts and whose OBO call makes Purview DLP enforce.
MSX_API_BASE_URL="http://localhost:4000"
# 'foundry' (hosted agent, default) or 'in-app' (only if IN_APP_ENGINE_ENABLED=true on the API).
MSX_CHAT_ENGINE="foundry"
# Only needed if the API enforces a shared secret (root .env API_KEY is set, e.g. over a tunnel).
MSX_API_KEY=""
# A signed-in seller's Entra ACCESS TOKEN (audience = the MSX API app). REQUIRED for the
# --mode dlp run to make Purview DLP *enforce/alert*; without it DLP only audits.
# Get one via MSAL / `az account get-access-token` for the API's scope, then paste here.
MSX_USER_BEARER=""
# Per-request timeout in seconds (hosted agent + tools can be slow).
MSX_REQUEST_TIMEOUT="120"

# ---- Optional scan defaults (CLI flags override these) ----
REDTEAM_NUM_OBJECTIVES="5"
REDTEAM_DLP_SEED_FILE="dlp_seed_prompts.json"
REDTEAM_OUTPUT_DIR="results"
